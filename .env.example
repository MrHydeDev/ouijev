# Copy this file to .env and fill in whatever you'll use. Everything is optional:
# with nothing set, the board starts in demo mode with canned answers.

# --- Jev (TypeSafe AI): the one who answers ------------------------------------------
# API key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest

# --- The scribe: an LLM that proposes answers for Jev to pick from --------------------
# Without a scribe, Jev answers on its own from its phrasebooks and word lists: Spanish or English only.
# Providers: opencode-go, opencode-zen, openai, anthropic, gemini, openrouter,
#            deepseek, groq, mistral, ollama, lmstudio, custom or none.
LLM_PROVIDER=

# The API key is read from LLM_API_KEY and, if that's empty, from the provider's usual
# variable (OPENCODE_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY...).
# LLM_API_KEY=

# Every provider has a default model (see the README), except lmstudio and custom, which need this.
# LLM_MODEL=

# Required with LLM_PROVIDER=custom; also handy for going through a proxy.
# LLM_BASE_URL=

# Extra parameters for the provider request, as JSON (merged with the built-in ones).
# A null removes a built-in parameter your model doesn't accept: {"response_format": null}
# LLM_EXTRA_BODY={"temperature": 0.7}

# Time limit for the candidates; when it runs out, Jev answers on its own.
# At most 30000, so that still fits in the 60 s a seance gets.
# LLM_TIMEOUT_MS=20000

# --- Server --------------------------------------------------------------------------
# Beyond localhost, anyone who reaches the port spends your API keys. Open it by IP address:
# against DNS rebinding, it turns away every domain name but localhost.
# HOST=127.0.0.1
# PORT=3666
# error, warn, info or debug
# LOG_LEVEL=info
